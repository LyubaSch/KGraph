NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_password

# Optional YandexGPT settings for the experimental NLP/agent pipeline.
# The Neo4j demo and current frontend/backend work without these values.
YANDEXGPT_FOLDER_ID=your_folder_id
YANDEXGPT_API_KEY=
YANDEXGPT_IAM_TOKEN=
YANDEXGPT_MODEL=yandexgpt-lite/latest
YANDEXGPT_MODEL_URI=
YANDEXGPT_ENDPOINT=https://llm.api.cloud.yandex.net/foundationModels/v1/completion
